generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// USER
// ==============================
enum Role {
  USER
  ADMIN
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(uuid())

  first_name    String
  last_name     String?
  email         String  @unique
  password_hash String
  city          String?
  address       String?
  phone         String?
  postal_code   String?

  avatar_url String?
  role       Role    @default(USER)

  refresh_token RefreshToken?
  // Perfil opcional para quando o utilizador decide ser profissional
  professional  ProfessionalProfile?

  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  jobs            Job[]      @relation("ClientJobs")
  reviewsGiven    Review[]   @relation("ReviewsGiven")
  reviewsReceived Review[]   @relation("ReviewsReceived")
  proposals       Proposal[] @relation("ProfessionalProposals")

  @@map("users")
}

// ==============================
// REFRESH TOKEN
// ==============================

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  expiresIn DateTime @map("expires_in")
  isRevoked Boolean  @default(false) @map("is_revoked")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refresh_token")
}

// ==============================
// CATEGORY
// ==============================

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio         String?
  hourlyRate  Decimal?
  isAvailable Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[] // Relação direta implícita
}

model Category {
  id            String                @id @default(uuid())
  name          String                @unique
  imageUrl      String?
  jobs          Job[]
  professionals ProfessionalProfile[] // Relação direta implícita
}

// ==============================
// ENUM
// ==============================

model Job {
  id               String    @id @default(uuid())
  title            String
  description      String
  status           JobStatus @default(OPEN)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Local onde o serviço será realizado
  locationVerified Boolean   @default(false)

  address     String?
  city        String?
  postal_code String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  clientId String
  client   User   @relation("ClientJobs", fields: [clientId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images    JobImage[]
  proposals Proposal[]
  reviews   Review[]
}

model JobImage {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // Ex: 1 a 5
  comment   String?
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  authorId String
  author   User   @relation("ReviewsGiven", fields: [authorId], references: [id])

  targetId String
  target   User   @relation("ReviewsReceived", fields: [targetId], references: [id])
}

model Proposal {
  id          String   @id @default(uuid())
  price       Decimal
  coverLetter String?
  createdAt   DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("ProfessionalProposals", fields: [professionalId], references: [id])
}
