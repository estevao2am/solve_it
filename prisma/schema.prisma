generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum Role {
  USER
  ADMIN
  PROFESSIONAL
}

// Fluxo: OPEN → AWAITING_PAYMENT → PAID → IN_PROGRESS → AWAITING_CONFIRMATION → COMPLETED
enum JobStatus {
  OPEN
  PENDING
  AWAITING_PAYMENT // proposta aceite, à espera do pagamento do cliente
  PAID // pagamento retido na plataforma, à espera do início
  IN_PROGRESS
  AWAITING_CONFIRMATION // profissional terminou, cliente tem de confirmar
  COMPLETED
  CANCELLED
}

enum ProfessionalType {
  INDEPENDENT
  COMPANY
  OTHER
}

enum DocumentType {
  NIF_PROOF
  NISS_PROOF
  PAYMENT_PROOF
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================
// USER
// ==============================

model User {
  id            String  @id @default(uuid())
  first_name    String
  last_name     String?
  email         String  @unique
  password_hash String
  city          String?
  address       String?
  phone         String?
  postal_code   String?
  avatar_url    String?
  role          Role    @default(USER)

  refresh_token RefreshToken?
  professional  ProfessionalProfile?

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  jobs            Job[]          @relation("ClientJobs")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  proposals       Proposal[]     @relation("ProfessionalProposals")
  notifications   Notification[]

  wallet           Wallet?
  paymentsMade     Payment[] @relation("ClientPayments")
  paymentsReceived Payment[] @relation("ProfessionalPayments")

  @@map("users")
}

// ==============================
// REFRESH TOKEN
// ==============================

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  expiresIn DateTime @map("expires_in")
  isRevoked Boolean  @default(false) @map("is_revoked")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refresh_token")
}

// ==============================
// PROFESSIONAL PROFILE
// ==============================

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Atividade Profissional
  bio             String?
  experienceYears Int?
  isAvailable     Boolean @default(true)

  // Estado da Verificação
  status     ProfessionalStatus @default(PENDING)
  isVerified Boolean            @default(false)

  // Dados Fiscais
  fiscalType ProfessionalType
  nif        String
  niss       String?

  // Dados de Pagamento
  accountHolder String
  iban          String

  // Método de recebimento usado nos levantamentos da carteira
  payoutMethod    PayoutMethod @default(BANK_TRANSFER)
  payoutPhone     String? // MB WAY
  payoutCardLast4 String? // Cartão (só os últimos 4 dígitos)

  // Documentos
  documents ProfessionalDocument[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  portfolioItems PortfolioItem[]

  @@index([categoryId])
  @@index([status])
  @@index([nif])
  @@map("professional_profiles")
}

// ==============================
// PROFESSIONAL DOCUMENT
// ==============================

model ProfessionalDocument {
  id String @id @default(uuid())

  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  type       DocumentType
  name       String
  uri        String
  mimeType   String?
  size       Int?
  isVerified Boolean      @default(false)
  fileHash   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalProfileId, fileHash])
  @@unique([professionalProfileId, type])
  @@index([professionalProfileId])
  @@index([type])
  @@index([fileHash])
  @@map("professional_documents")
}

// ==============================
// CATEGORY
// ==============================

model Category {
  id            String                @id @default(uuid())
  name          String                @unique
  title         String?
  imageUrl      String?
  jobs          Job[]
  professionals ProfessionalProfile[]

  @@map("categories")
}

// ==============================
// JOB & RELATED
// ==============================

model Job {
  id               String    @id @default(uuid())
  title            String
  description      String
  status           JobStatus @default(OPEN)
  locationVerified Boolean   @default(false)

  address     String?
  city        String?
  postal_code String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  clientId   String
  client     User     @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images    JobImage[]
  proposals Proposal[]
  reviews   Review[]
  payment   Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

model JobImage {
  id        String   @id @default(uuid())
  url       String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("job_images")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Proposal {
  id          String  @id @default(uuid())
  price       Decimal @db.Decimal(10, 2)
  coverLetter String?

  status ProposalStatus @default(PENDING)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("ProfessionalProposals", fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobId, professionalId])
  @@index([jobId])
  @@index([professionalId])
  @@index([status])
  @@map("proposals")
}

enum NotificationType {
  ACCOUNT_CREATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  SYSTEM
  PROPOSAL_ACCEPTED
  PROPOSAL_NOT_SELECTED
  PAYMENT_CONFIRMED
  JOB_STATUS_UPDATED
  WALLET_CREDITED
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Dados para a app abrir o ecrã certo (ex.: { paymentId, jobId, amount })
  data Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model PortfolioItem {
  id          String  @id @default(uuid())
  title       String
  description String?

  professionalProfileId String

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  images PortfolioImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@map("portfolio_items")
}

model PortfolioImage {
  id String @id @default(uuid())

  url String

  portfolioItemId String

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([portfolioItemId])
  @@map("portfolio_images")
}

// ==============================
// PAGAMENTOS (ESCROW) & CARTEIRA
// ==============================

enum PaymentMethod {
  CARD
  MBWAY
  MULTIBANCO
}

enum PaymentStatus {
  PENDING // à espera de confirmação do provider (ex.: referência Multibanco)
  HELD // pago pelo cliente e retido na plataforma
  RELEASED // transferido para a carteira do profissional
  REFUNDED
  FAILED
}

// Um pagamento por trabalho. O valor fica retido (HELD) até o cliente
// confirmar a conclusão; nessa altura é creditado na carteira (RELEASED).
model Payment {
  id String @id @default(uuid())

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  clientId       String
  client         User   @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Restrict)
  professionalId String
  professional   User   @relation("ProfessionalPayments", fields: [professionalId], references: [id], onDelete: Restrict)

  amount             Decimal @db.Decimal(10, 2) // pago pelo cliente
  platformFee        Decimal @db.Decimal(10, 2)
  professionalAmount Decimal @db.Decimal(10, 2) // creditado na carteira

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  providerRef String?
  phone       String? // MB WAY
  mbEntity    String? // Multibanco
  mbReference String? // Multibanco

  paidAt     DateTime?
  releasedAt DateTime?

  walletTransaction WalletTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([professionalId, status])
  @@map("payments")
}

model Wallet {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  balance Decimal @default(0) @db.Decimal(12, 2)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

enum WalletTransactionType {
  CREDIT
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Forma de levantamento do saldo da carteira
enum PayoutMethod {
  BANK_TRANSFER
  MBWAY
  CARD
}

model WalletTransaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type        WalletTransactionType
  status      WalletTransactionStatus @default(COMPLETED)
  amount      Decimal                 @db.Decimal(12, 2)
  description String

  // Só em levantamentos: método e destino já mascarado (ex.: "Cartão •••• 4242")
  payoutMethod      PayoutMethod?
  payoutDestination String?

  // Único: garante que um pagamento só é creditado uma vez.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}
