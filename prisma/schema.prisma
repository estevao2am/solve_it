generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum Role {
  USER
  ADMIN
  PROFESSIONAL
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProfessionalType {
  INDEPENDENT
  COMPANY
  OTHER
}

enum DocumentType {
  NIF_PROOF
  NISS_PROOF
  PAYMENT_PROOF
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================
// USER
// ==============================

model User {
  id            String  @id @default(uuid())
  first_name    String
  last_name     String?
  email         String  @unique
  password_hash String
  city          String?
  address       String?
  phone         String?
  postal_code   String?
  avatar_url    String?
  role          Role    @default(USER)

  refresh_token RefreshToken?
  professional  ProfessionalProfile?

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  jobs            Job[]          @relation("ClientJobs")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  proposals       Proposal[]     @relation("ProfessionalProposals")
  notifications   Notification[]

  @@map("users")
}

// ==============================
// REFRESH TOKEN
// ==============================

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  expiresIn DateTime @map("expires_in")
  isRevoked Boolean  @default(false) @map("is_revoked")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refresh_token")
}

// ==============================
// PROFESSIONAL PROFILE
// ==============================

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Atividade Profissional
  bio             String?
  experienceYears Int?
  isAvailable     Boolean @default(true)

  // Estado da Verificação
  status     ProfessionalStatus @default(PENDING)
  isVerified Boolean            @default(false)

  // Dados Fiscais
  fiscalType ProfessionalType
  nif        String
  niss       String?

  // Dados de Pagamento
  accountHolder String
  iban          String

  // Documentos
  documents ProfessionalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([nif])
  @@map("professional_profiles")
}

// ==============================
// PROFESSIONAL DOCUMENT
// ==============================

model ProfessionalDocument {
  id String @id @default(uuid())

  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  type       DocumentType
  name       String
  uri        String
  mimeType   String?
  size       Int?
  isVerified Boolean      @default(false)
  fileHash   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalProfileId, fileHash])
  @@unique([professionalProfileId, type])
  @@index([professionalProfileId])
  @@index([type])
  @@index([fileHash])
  @@map("professional_documents")
}

// ==============================
// CATEGORY
// ==============================

model Category {
  id            String                @id @default(uuid())
  name          String                @unique
  title         String?
  imageUrl      String?
  jobs          Job[]
  professionals ProfessionalProfile[]

  @@map("categories")
}

// ==============================
// JOB & RELATED
// ==============================

model Job {
  id               String    @id @default(uuid())
  title            String
  description      String
  status           JobStatus @default(OPEN)
  locationVerified Boolean   @default(false)

  address     String?
  city        String?
  postal_code String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  clientId   String
  client     User     @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images    JobImage[]
  proposals Proposal[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

model JobImage {
  id        String   @id @default(uuid())
  url       String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("job_images")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Proposal {
  id             String   @id @default(uuid())
  price          Decimal  @db.Decimal(10, 2)
  coverLetter    String?
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User     @relation("ProfessionalProposals", fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@map("proposals")
}

enum NotificationType {
  ACCOUNT_CREATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  SYSTEM
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
