# Database (o postgres do docker-compose.yml)
DATABASE_URL="postgresql://docker:docker@localhost:5432/solve_db?schema=public"

# JWT (o `npm run setup` gera um segredo aleatório ao criar o .env)
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mail (Mailpit do docker-compose.yml — caixa de entrada em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Solve <no-reply@solve.local>"

# Pagamentos
# Comissão da plataforma (%) descontada ao valor do profissional (0 por omissão)
PLATFORM_FEE_PERCENT=0
