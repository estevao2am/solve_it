# Database (o postgres do docker-compose.yml)
DATABASE_URL="postgresql://docker:docker@localhost:5432/solve_db?schema=public"

# JWT (o `npm run setup` gera um segredo aleatório ao criar o .env)
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mail (Mailpit do docker-compose.yml — caixa de entrada em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Solve <no-reply@solve.local>"

# Pagamentos
# Comissão da plataforma (%) descontada ao valor do profissional (0 por omissão)
PLATFORM_FEE_PERCENT=0

# Pesquisa de moradas (GET /location/autocomplete e /location/place/:id)
# Com chave: Google Places API (New) — recomendado. Na Google Cloud, ativar
# "Places API (New)", criar uma chave e restringi-la a essa API.
GOOGLE_PLACES_API_KEY=
# Sem chave da Google usa o Photon/OpenStreetMap. Vazio = servidor público
# (lento, "fair use", só para testes) ou um Photon próprio com o índice de PT.
PHOTON_URL=
